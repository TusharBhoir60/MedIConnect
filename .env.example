# ─────────────────────────────────────────────
# MedIConnect — Environment Variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# MongoDB Atlas connection string (server-only — never use NEXT_PUBLIC_)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Twilio credentials (optional — demo mode works without these)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Public base URL for Twilio webhooks (set to ngrok URL in dev)
NEXT_PUBLIC_BASE_URL=https://<your-ngrok-subdomain>.ngrok-free.app

# IVR Express server URL (only if running twilio-ivr separately)
TWILIO_IVR_BASE_URL=https://<your-ngrok-subdomain>.ngrok-free.app

